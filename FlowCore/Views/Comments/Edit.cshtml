@model CommentFormVm
@{
    ViewData["Title"] = "Edit comment";
    var taskTitle = ViewBag.TaskTitle as string;
    var taskId = ViewBag.TaskId as Guid?;
}
<h1 class="font-headline text-3xl font-extrabold tracking-tight text-fg">Edit comment</h1>
@if (!string.IsNullOrEmpty(taskTitle))
{
    <p class="mt-2 text-sm font-medium text-fg-secondary">On: @taskTitle</p>
}
<form method="post" asp-action="Edit" class="mt-8 max-w-2xl space-y-5">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-sm text-[var(--color-error)]"></div>
    <div>
        <label asp-for="Body" class="block text-sm font-medium text-fg-secondary">Comment</label>
        <textarea asp-for="Body" rows="6" class="mt-1 w-full rounded-xl border border-border bg-[var(--color-surface)] px-3 py-2 text-fg focus:border-[var(--color-secondary)] focus:outline-none focus:ring-1 focus:ring-[var(--color-secondary)]"></textarea>
        <span asp-validation-for="Body" class="mt-1 block text-xs text-[var(--color-error)]"></span>
    </div>
    <div class="flex gap-3">
        <button type="submit" class="flex items-center gap-2 rounded-full bg-[var(--color-secondary)] px-4 py-2 text-sm font-semibold text-[var(--color-on-secondary)] shadow-sm transition-opacity hover:opacity-95">
            <span class="material-symbols-outlined text-[18px]" aria-hidden="true">save</span>
            Save changes
        </button>
        @if (taskId is { } tid)
        {
            <a asp-controller="Tasks" asp-action="Details" asp-route-id="@tid" class="rounded-full border border-border bg-[var(--color-surface)] px-4 py-2 text-sm font-semibold text-fg transition-colors hover:bg-[var(--color-surface-container)]">Cancel</a>
        }
    </div>
</form>
