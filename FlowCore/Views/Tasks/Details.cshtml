@model TaskItem
@using FlowCore.Models
@using FlowCore.Services
@inject FlowCore.Services.UiText T
@{
    ViewData["Title"] = Model.Title;
    var project = Model.Board?.Project;
    var board = Model.Board;
    var assignees = Model.TaskAssignments
        .Where(a => a.User is not null)
        .Select(a => a.User!)
        .DistinctBy(u => u.Id)
        .OrderBy(u => u.FullName)
        .ToList();
}
<div class="lg:grid lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-12">
    <article>
        <header class="border-b border-fg-muted/15 pb-7">
            <div class="flex flex-wrap items-center gap-2 text-xs text-fg-muted">
                @if (Model.ParentTaskItemId is { } parentId)
                {
                    <span class="rounded-full bg-primary/10 px-2.5 py-1 font-medium text-primary">Subtask</span>
                }
                <span>@Model.Priority</span>
            </div>
            <h1 class="mt-3 max-w-4xl font-display text-5xl font-extrabold leading-[0.96] tracking-tight text-fg sm:text-6xl">@Model.Title</h1>
        </header>

        <div class="mt-8 space-y-9">
            <section>
                <h2 class="text-xs font-bold uppercase tracking-[0.14em] text-fg-muted">Description</h2>
                <div class="mt-3 max-w-3xl whitespace-pre-wrap text-[15px] leading-7 text-fg-secondary">@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</div>
            </section>

            @if (Model.Attachments.Count > 0)
            {
                <section>
                    <h2 class="text-xs font-bold uppercase tracking-[0.14em] text-fg-muted">Images</h2>
                    <ul class="mt-4 grid max-w-3xl grid-cols-2 gap-3 sm:grid-cols-3">
                        @foreach (var image in Model.Attachments.OrderByDescending(x => x.CreatedAt))
                        {
                            <li class="overflow-hidden rounded-xl border border-fg-muted/15 bg-card shadow-soft">
                                <a href="/attachments/@image.Id/content" target="_blank" rel="noopener" class="block outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-app">
                                    <img src="/attachments/@image.Id/content" alt="@image.FileName" class="h-36 w-full object-cover" />
                                </a>
                                <div class="truncate px-3 py-2 text-xs text-fg-secondary" title="@image.FileName">@image.FileName</div>
                            </li>
                        }
                    </ul>
                </section>
            }

            @if (Model.ParentTaskItemId is { } pp)
            {
                <p class="text-sm">
                    <a class="rounded-lg border border-primary/35 px-3 py-2 font-medium text-primary outline-none transition-colors hover:bg-primary/10 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-app"
                       asp-controller="Tasks" asp-action="Details" asp-route-id="@pp">Open parent task</a>
                </p>
            }

            <section>
                <h2 class="text-xs font-bold uppercase tracking-[0.14em] text-fg-muted">Subtasks</h2>
                @if (project is not null && board is not null)
                {
                    <p class="mt-3">
                        <a class="inline-flex rounded-full border border-primary/35 px-4 py-2 text-sm font-medium text-primary outline-none transition-colors hover:bg-primary/10 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-app"
                           asp-controller="Tasks" asp-action="Create" asp-route-projectId="@project.Id" asp-route-boardId="@board.Id" asp-route-parentTaskItemId="@Model.Id">@T["crud.tasks.subtask_create"]</a>
                    </p>
                }
                @if (Model.Subtasks.Count > 0)
                {
                    <ul class="mt-4 space-y-2.5">
                        @foreach (var s in Model.Subtasks.OrderBy(x => x.Title))
                        {
                            <li>
                                <a asp-controller="Tasks" asp-action="Details" asp-route-id="@s.Id"
                                   class="flex items-center justify-between rounded-xl border border-fg-muted/10 bg-card px-4 py-3 text-sm shadow-soft outline-none transition-colors duration-150 hover:border-primary/30 hover:bg-raised focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-app">
                                    <span class="font-medium text-fg">@s.Title</span>
                                    <span class="text-fg-muted" aria-hidden="true">→</span>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section>
                <h2 class="text-xs font-bold uppercase tracking-[0.14em] text-fg-muted">Comments</h2>
                <form method="post" asp-action="AddComment" asp-route-id="@Model.Id" class="mt-4 space-y-3">
                    @Html.AntiForgeryToken()
                    <label class="sr-only" for="comment-body">@T["crud.tasks.add_comment"]</label>
                    <textarea id="comment-body" name="Body" rows="3" required
                              placeholder="@(T["crud.tasks.comment_placeholder"])"
                              class="w-full rounded-xl border border-fg-muted/20 bg-card px-4 py-3 text-sm text-fg shadow-soft focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"></textarea>
                    <button type="submit" class="ml-auto flex items-center gap-2 rounded-full bg-primary px-6 py-2.5 text-sm font-semibold text-on-primary shadow-sm transition-opacity hover:opacity-95">
                        <partial name="_Icon" model='new IconVm { Name = "paper-airplane", Size = 18 }'/>
                        @T["crud.tasks.add_comment"]
                    </button>
                </form>
                @if (Model.Comments.Count > 0)
                {
                    <ul class="mt-6 space-y-4 border-l border-fg-muted/20 pl-4">
                        @foreach (var c in Model.Comments.OrderBy(x => x.CreatedAt))
                        {
                            var author = c.Author?.FullName ?? "User";
                            var initial = author.Length > 0 ? author[0] : '?';
                            <li class="relative">
                                <div class="absolute -left-[21px] top-1 flex h-6 w-6 items-center justify-center rounded-full bg-raised text-xs font-semibold text-fg-secondary" aria-hidden="true">@initial</div>
                                <div class="rounded-xl border border-fg-muted/10 bg-card p-4 shadow-card">
                                    <div class="flex flex-wrap items-baseline justify-between gap-2 text-xs text-fg-muted">
                                        <span class="font-medium text-fg-secondary">@author</span>
                                        <time datetime="@c.CreatedAt.ToString("O")">@c.CreatedAt.ToString("g")</time>
                                    </div>
                                    <p class="mt-2 whitespace-pre-wrap text-sm text-fg-secondary">@c.Body</p>
                                    @if (c.EditedAt is { } edited)
                                    {
                                        <p class="mt-1 text-[10px] italic text-fg-muted">edited @edited.ToString("g")</p>
                                    }
                                    <div class="mt-3 flex gap-2 text-xs">
                                        <a asp-controller="Comments" asp-action="Edit" asp-route-id="@c.Id" class="rounded-md border border-border px-2 py-1 text-fg-secondary hover:bg-[var(--color-surface-container)]">Edit</a>
                                        <form method="post" asp-controller="Comments" asp-action="Delete" asp-route-id="@c.Id" class="inline" onsubmit="return confirm('Delete this comment?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="rounded-md border border-brand-warn/40 px-2 py-1 text-brand-warn hover:bg-brand-warn/10">Delete</button>
                                        </form>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>

        @if (board is not null)
        {
            <p class="mt-10 border-t border-fg-muted/15 pt-6">
                <a class="inline-flex items-center rounded-full border border-fg-muted/25 bg-card px-4 py-2 text-sm font-semibold text-fg outline-none transition-colors hover:border-primary/40 hover:bg-primary/10 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-app"
                   asp-controller="Boards" asp-action="Details" asp-route-id="@board.Id"><span aria-hidden="true">← </span>Back to board</a>
            </p>
        }
    </article>

    <aside class="mt-10 lg:mt-0">
        <div class="sticky top-6 rounded-2xl border border-fg-muted/15 bg-card p-6 shadow-card">
            <h2 class="text-sm font-bold uppercase tracking-[0.12em] text-fg-secondary">Details</h2>
            <dl class="mt-5 space-y-4 text-sm">
                <div>
                    <dt class="text-[11px] font-semibold uppercase tracking-[0.12em] text-fg-muted">Status</dt>
                    <dd class="mt-1 text-base font-semibold text-fg">@(Model.TaskStatusDefinition?.Name ?? "—")</dd>
                </div>
                <div>
                    <dt class="text-[11px] font-semibold uppercase tracking-[0.12em] text-fg-muted">Priority</dt>
                    <dd class="mt-1 text-base font-semibold text-fg">@Model.Priority</dd>
                </div>
                <div>
                    <dt class="text-[11px] font-semibold uppercase tracking-[0.12em] text-fg-muted">Story points</dt>
                    <dd class="mt-1 text-base font-semibold text-fg">@Model.StoryPoints</dd>
                </div>
                @if (Model.DueDate is { } due)
                {
                    <div>
                        <dt class="text-[11px] font-semibold uppercase tracking-[0.12em] text-fg-muted">Due</dt>
                        <dd class="mt-1 text-base font-semibold text-fg">@due.ToString("g")</dd>
                    </div>
                }
                @if (project is not null)
                {
                    <div>
                        <dt class="text-[11px] font-semibold uppercase tracking-[0.12em] text-fg-muted">Project</dt>
                        <dd class="mt-1">
                            <a class="rounded text-primary outline-none hover:text-fg focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-card" asp-controller="Projects" asp-action="Details" asp-route-id="@project.Id">@project.Name</a>
                        </dd>
                    </div>
                }
                @if (assignees.Count > 0)
                {
                    <div>
                        <dt class="text-[11px] font-semibold uppercase tracking-[0.12em] text-fg-muted">Assignees</dt>
                        <dd class="mt-1.5 flex flex-col gap-1.5">
                            @foreach (var u in assignees)
                            {
                                <a asp-controller="Users" asp-action="Details" asp-route-id="@u.Id"
                                   class="inline-flex items-center gap-2 rounded-full border border-fg-muted/15 bg-raised/60 py-0.5 pl-0.5 pr-2.5 text-xs font-medium text-fg outline-none transition-colors hover:border-primary/40 hover:bg-raised focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-card">
                                    <span class="flex h-6 w-6 items-center justify-center rounded-full text-[10px] font-bold text-white" style="background:@UserDisplayHelper.BackgroundColorForUser(u.Id)">@UserDisplayHelper.GetInitials(u.FullName)</span>
                                    <span>@u.FullName</span>
                                </a>
                            }
                        </dd>
                    </div>
                }
                @if (Model.TaskTags.Count > 0)
                {
                    <div>
                        <dt class="text-[11px] font-semibold uppercase tracking-[0.12em] text-fg-muted">Tags</dt>
                        <dd class="mt-1.5 flex flex-wrap gap-1.5">
                            @foreach (var tt in Model.TaskTags.OrderBy(x => x.Tag?.Name))
                            {
                                <a asp-controller="Tags" asp-action="Details" asp-route-id="@tt.TagId"
                                   class="rounded-full border border-fg-muted/20 bg-raised/80 px-2.5 py-0.5 text-xs font-medium text-primary outline-none transition-colors hover:border-primary/50 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-card">#@(tt.Tag?.Name ?? "tag")</a>
                            }
                        </dd>
                    </div>
                }
            </dl>
            @if (project is not null)
            {
                <div class="mt-6 grid grid-cols-2 gap-2.5 border-t border-fg-muted/15 pt-5">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="block rounded-full border border-fg-muted/25 bg-raised/40 px-3 py-2.5 text-center text-sm font-semibold text-fg transition-colors hover:border-primary/35 hover:bg-primary/10">Edit task</a>
                    <form method="post" asp-action="Delete" asp-route-id="@Model.Id" onsubmit="return confirm('Delete this task and its subtasks?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="w-full rounded-full border border-brand-warn/40 px-3 py-2.5 text-sm font-semibold text-brand-warn transition-colors hover:bg-brand-warn/10">@T["crud.tasks.delete"]</button>
                    </form>
                </div>
            }
        </div>
    </aside>
</div>
