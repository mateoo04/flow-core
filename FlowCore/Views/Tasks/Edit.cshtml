@model TaskEditFormVm
@inject FlowCore.Services.UiText T
@{
    ViewData["Title"] = "Edit task";
    var project = ViewBag.Project as Project;
    var board = ViewBag.Board as Board;
    var statuses = ViewBag.Statuses as IReadOnlyList<TaskStatusDefinition> ?? Array.Empty<TaskStatusDefinition>();
    if (project is null || board is null)
    {
        throw new InvalidOperationException("Project and board are required.");
    }
}
<h1 class="font-headline text-3xl font-extrabold tracking-tight text-fg">Edit task</h1>
<p class="mt-2 text-sm font-medium text-fg-secondary">@project.Name — @board.Name</p>
<form method="post" asp-action="Edit" asp-route-id="@Model.Id" class="mt-8 max-w-xl space-y-5">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-sm text-[var(--color-error)]"></div>
    <div>
        <label asp-for="Title" class="block text-sm font-medium text-fg-secondary">Title</label>
        <input asp-for="Title" class="mt-1 w-full rounded-xl border border-border bg-[var(--color-surface)] px-3 py-2 text-fg focus:border-[var(--color-secondary)] focus:outline-none focus:ring-1 focus:ring-[var(--color-secondary)]"/>
        <span asp-validation-for="Title" class="mt-1 block text-xs text-[var(--color-error)]"></span>
    </div>
    <div>
        <label asp-for="Description" class="block text-sm font-medium text-fg-secondary">Description</label>
        <textarea asp-for="Description" rows="4" class="mt-1 w-full rounded-xl border border-border bg-[var(--color-surface)] px-3 py-2 text-fg focus:border-[var(--color-secondary)] focus:outline-none focus:ring-1 focus:ring-[var(--color-secondary)]"></textarea>
        <span asp-validation-for="Description" class="mt-1 block text-xs text-[var(--color-error)]"></span>
    </div>
    <div>
        <label asp-for="TaskStatusDefinitionId" class="block text-sm font-medium text-fg-secondary">Status</label>
        <select asp-for="TaskStatusDefinitionId" class="mt-1 w-full rounded-xl border border-border bg-[var(--color-surface)] px-3 py-2 text-fg focus:border-[var(--color-secondary)] focus:outline-none focus:ring-1 focus:ring-[var(--color-secondary)]">
            @foreach (var s in statuses.OrderBy(x => x.Position))
            {
                <option value="@s.Id">@s.Name</option>
            }
        </select>
        <span asp-validation-for="TaskStatusDefinitionId" class="mt-1 block text-xs text-[var(--color-error)]"></span>
    </div>
    <div>
        <label asp-for="Priority" class="block text-sm font-medium text-fg-secondary">Priority</label>
        <select asp-for="Priority" asp-items="Html.GetEnumSelectList<TaskPriority>()" class="mt-1 w-full rounded-xl border border-border bg-[var(--color-surface)] px-3 py-2 text-fg focus:border-[var(--color-secondary)] focus:outline-none focus:ring-1 focus:ring-[var(--color-secondary)]"></select>
    </div>
    <div>
        <label asp-for="StoryPoints" class="block text-sm font-medium text-fg-secondary">Story points</label>
        <input asp-for="StoryPoints" type="number" min="0" class="mt-1 w-full rounded-xl border border-border bg-[var(--color-surface)] px-3 py-2 text-fg focus:border-[var(--color-secondary)] focus:outline-none focus:ring-1 focus:ring-[var(--color-secondary)]"/>
    </div>
    <div>
        <label asp-for="DueDate" class="block text-sm font-medium text-fg-secondary">Due (optional)</label>
        <div class="mt-1">
            <partial name="_DateTimePicker" model="@(new DateTimePickerModel { FieldName = nameof(Model.DueDate), Value = Model.DueDate, Placeholder = "Pick a date and time" })"/>
        </div>
    </div>
    <div>
        <label class="block text-sm font-medium text-fg-secondary">Assignees</label>
        <div class="mt-1">
            <partial name="_AutocompleteMulti" model="@(new AutocompleteMultiModel { FieldName = nameof(Model.AssigneeIds), SearchUrl = "/users/autocomplete", Placeholder = "Add assignees…", EmptyHint = "Search by name or email", Selected = Model.SelectedAssignees })"/>
        </div>
    </div>
    <div class="flex gap-3">
        <button type="submit" class="flex items-center gap-2 rounded-full bg-[var(--color-secondary)] px-4 py-2 text-sm font-semibold text-[var(--color-on-secondary)] shadow-sm transition-opacity hover:opacity-95">
            <partial name="_Icon" model='new IconVm { Name = "check-circle", Size = 18 }'/>
            Save changes
        </button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="rounded-full border border-border bg-[var(--color-surface)] px-4 py-2 text-sm font-semibold text-fg transition-colors hover:bg-[var(--color-surface-container)]">Cancel</a>
    </div>
</form>

<section class="mt-10 max-w-xl">
    <h2 class="font-headline text-xl font-bold text-fg">Images</h2>

    <form id="attachmentDropzone" class="dropzone mt-3 rounded-xl border border-dashed border-border bg-[var(--color-surface)] p-4"
          action="/tasks/@Model.Id/attachments" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
    </form>

    <div id="attachmentList" class="mt-4"></div>
</section>

@section Scripts {
    <link rel="stylesheet" href="~/lib/dropzone/dropzone.min.css" asp-append-version="true" />
    <script src="~/lib/dropzone/dropzone.min.js" asp-append-version="true"></script>
    <script>
        (function () {
            const taskId = "@Model.Id";
            const token = document.querySelector('#attachmentDropzone input[name="__RequestVerificationToken"]').value;
            const listEl = document.getElementById("attachmentList");

            async function loadAttachments() {
                const res = await fetch(`/tasks/${taskId}/attachments`, { headers: { "RequestVerificationToken": token } });
                listEl.innerHTML = await res.text();
            }

            Dropzone.autoDiscover = false;
            const dz = new Dropzone("#attachmentDropzone", {
                url: `/tasks/${taskId}/attachments`,
                paramName: "file",
                maxFilesize: 5, // MB
                acceptedFiles: "image/*",
                headers: { "RequestVerificationToken": token },
                dictDefaultMessage: "Drop images here or click to upload"
            });
            dz.on("success", function (file) { dz.removeFile(file); loadAttachments(); });

            listEl.addEventListener("click", async function (e) {
                const btn = e.target.closest("[data-delete-attachment]");
                if (!btn) return;
                const id = btn.getAttribute("data-delete-attachment");
                await fetch(`/attachments/${id}/delete`, { method: "POST", headers: { "RequestVerificationToken": token } });
                loadAttachments();
            });

            loadAttachments();
        })();
    </script>
}
