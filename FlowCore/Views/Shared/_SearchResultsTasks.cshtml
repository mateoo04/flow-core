@model SearchResultsVm<SearchTaskRow>
@inject FlowCore.Services.UiText T
@if (Model.Query.Length == 0)
{
    return;
}
@if (Model.Rows.Count == 0)
{
    <div class="px-3 py-3 text-sm text-fg-muted">
        @string.Format(T["search.empty.tasks"], Model.Query)
    </div>
}
else
{
    foreach (var row in Model.Rows)
    {
        <a data-search-result href="@Url.Action("Details", "Tasks", new { id = row.Id })"
           class="flex items-center gap-3 border-l-2 border-transparent px-3 py-2 text-sm text-fg no-underline transition-colors hover:bg-raised data-[highlight=true]:border-[var(--color-primary)] data-[highlight=true]:bg-[var(--color-surface-container)]">
            @if (!string.IsNullOrWhiteSpace(row.StatusColorHex))
            {
                <span class="h-2 w-2 shrink-0 rounded-full" style="background-color: @row.StatusColorHex" aria-hidden="true"></span>
            }
            else
            {
                <span class="material-symbols-outlined text-[18px] text-fg-muted" aria-hidden="true">task_alt</span>
            }
            <span class="min-w-0 flex-1">
                <span class="block truncate font-medium">@row.Title</span>
                @if (!string.IsNullOrWhiteSpace(row.ProjectName))
                {
                    <span class="block truncate text-xs text-fg-muted">@row.ProjectName</span>
                }
            </span>
        </a>
    }
}
