@model AiAssistantVm
<div data-ai-assistant data-extract-url="/ai/tasks/extract" data-create-url="/ai/tasks/create">
    <button type="button" data-ai-open aria-haspopup="dialog" aria-controls="ai-assistant-modal"
            class="fixed bottom-5 right-5 z-40 inline-flex h-14 w-14 items-center justify-center rounded-full bg-[var(--color-primary)] text-[var(--color-on-primary)] shadow-lg transition-transform duration-200 hover:scale-105 hover:bg-[color-mix(in_srgb,var(--color-primary),black_10%)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:bottom-7 sm:right-7"
            aria-label="Open AI task assistant" title="Create a task with AI">
        <partial name="_Icon" model='new IconVm { Name = "sparkles", Size = 24, StrokeWidth = "1.75" }'/>
    </button>

    <div id="ai-assistant-modal" data-ai-modal role="dialog" aria-modal="true" aria-labelledby="ai-assistant-title"
         class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6">
        <div data-ai-backdrop class="absolute inset-0 bg-black/40 backdrop-blur-sm" aria-hidden="true"></div>
        <section class="relative w-full max-w-lg rounded-2xl border border-border bg-[var(--color-surface)] p-5 shadow-2xl sm:p-6">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <div class="mb-3 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-[var(--color-primary)]/10 text-[var(--color-primary)]">
                        <partial name="_Icon" model='new IconVm { Name = "sparkles", Size = 20, StrokeWidth = "1.75" }'/>
                    </div>
                    <h2 id="ai-assistant-title" class="font-display text-xl font-bold text-fg">Create a task with AI</h2>
                    <p class="mt-1 text-sm leading-6 text-fg-secondary">Describe what you need in plain language. You'll review the suggested details before anything is saved.</p>
                </div>
                <button type="button" data-ai-close class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-fg-muted transition-colors hover:bg-raised hover:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand" aria-label="Close AI assistant">
                    <partial name="_Icon" model='new IconVm { Name = "x-mark", Size = 20 }'/>
                </button>
            </div>

            @Html.AntiForgeryToken()
            @if (Model.Projects.Count == 0)
            {
                <p class="mt-6 rounded-lg bg-[var(--color-surface-container)] px-3 py-2 text-sm text-fg-secondary">Create a project first, then you can add tasks with AI.</p>
            }
            else
            {
            <form data-ai-form class="mt-6">
                <label for="ai-task-project" class="text-sm font-semibold text-fg">Project</label>
                <select id="ai-task-project" data-ai-project required class="mt-2 block w-full rounded-xl border border-border bg-app px-3 py-2.5 text-sm text-fg outline-none focus:border-[var(--color-brand)] focus:ring-2 focus:ring-[var(--color-brand)]/20">
                    @foreach (var project in Model.Projects)
                    {
                        if (project.Id == Model.ActiveProjectId)
                        {
                            <option value="@project.Id" selected>@project.Name</option>
                        }
                        else
                        {
                            <option value="@project.Id">@project.Name</option>
                        }
                    }
                </select>
                <label for="ai-task-prompt" class="text-sm font-semibold text-fg">What should we create?</label>
                <textarea id="ai-task-prompt" data-ai-prompt rows="4" required
                          class="mt-2 block w-full resize-none rounded-xl border border-border bg-app px-3 py-3 text-sm text-fg outline-none transition-colors placeholder:text-fg-muted focus:border-[var(--color-brand)] focus:ring-2 focus:ring-[var(--color-brand)]/20"
                          placeholder="Create a high-priority presentation task for Friday"></textarea>
                <p class="mt-2 text-xs text-fg-muted">For example: “Prepare the sprint review slides by Friday, high priority.”</p>

                <div class="mt-6 flex items-center justify-end gap-3">
                    <button type="button" data-ai-close class="rounded-lg px-3 py-2 text-sm font-semibold text-fg-secondary transition-colors hover:bg-raised hover:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">Cancel</button>
                    <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-[var(--color-primary)] px-4 py-2 text-sm font-semibold text-[var(--color-on-primary)] transition-colors hover:bg-[color-mix(in_srgb,var(--color-primary),black_10%)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
                        <partial name="_Icon" model='new IconVm { Name = "sparkles", Size = 16, StrokeWidth = "1.75" }'/>
                        Generate task
                    </button>
                </div>
                <p data-ai-status class="mt-4 hidden rounded-lg bg-[var(--color-surface-container)] px-3 py-2 text-sm text-fg-secondary" role="status"></p>
            </form>
            <section data-ai-preview class="mt-6 hidden rounded-xl border border-border bg-[var(--color-surface-container-low)] p-4">
                <p class="text-xs font-bold uppercase tracking-wide text-fg-muted">Review suggested task</p>
                <dl class="mt-3 space-y-2 text-sm">
                    <div><dt class="inline font-semibold text-fg">Title: </dt><dd data-ai-preview-title class="inline text-fg-secondary"></dd></div>
                    <div data-ai-preview-description-row><dt class="inline font-semibold text-fg">Description: </dt><dd data-ai-preview-description class="inline text-fg-secondary"></dd></div>
                    <div><dt class="inline font-semibold text-fg">Priority: </dt><dd data-ai-preview-priority class="inline capitalize text-fg-secondary"></dd></div>
                    <div data-ai-preview-date-row><dt class="inline font-semibold text-fg">Due date: </dt><dd data-ai-preview-date class="inline text-fg-secondary"></dd></div>
                </dl>
                <div class="mt-5 flex justify-end gap-3">
                    <button type="button" data-ai-back-to-prompt class="rounded-lg px-3 py-2 text-sm font-semibold text-fg-secondary hover:bg-raised">Back</button>
                    <button type="button" data-ai-create class="rounded-lg bg-[var(--color-primary)] px-4 py-2 text-sm font-semibold text-[var(--color-on-primary)] hover:bg-[color-mix(in_srgb,var(--color-primary),black_10%)]">Create task</button>
                </div>
            </section>
            }
        </section>
    </div>
</div>
