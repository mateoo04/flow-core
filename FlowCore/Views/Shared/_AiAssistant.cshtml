@model AiAssistantVm
@{
    var canCreateTask = Model.Projects.Count > 0;
    var canCreateProject = Model.Workspaces.Count > 0;
    var initialMode = canCreateTask ? "task" : "project";
}
<div data-ai-assistant data-task-extract-url="/ai/tasks/extract" data-task-create-url="/ai/tasks/create" data-project-extract-url="/ai/projects/extract" data-project-create-url="/ai/projects/create">
    <button type="button" data-ai-open aria-haspopup="dialog" aria-controls="ai-assistant-modal" aria-expanded="false" class="fixed bottom-5 right-5 z-40 inline-flex h-14 w-14 items-center justify-center rounded-full bg-[var(--color-primary)] text-[var(--color-on-primary)] shadow-lg transition-transform duration-200 hover:scale-105 hover:bg-[color-mix(in_srgb,var(--color-primary),black_10%)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:bottom-7 sm:right-7" aria-label="Open AI assistant" title="Create with AI">
        <partial name="_Icon" model='new IconVm { Name = "sparkles", Size = 24, StrokeWidth = "1.75" }'/>
    </button>
    <div id="ai-assistant-modal" data-ai-modal role="dialog" aria-modal="true" aria-labelledby="ai-assistant-title" class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6">
        <div data-ai-backdrop class="absolute inset-0 bg-black/40 backdrop-blur-sm" aria-hidden="true"></div>
        <section class="relative w-full max-w-lg rounded-2xl border border-border bg-[var(--color-surface)] p-5 shadow-2xl sm:p-6">
            <div class="flex items-start justify-between gap-4">
                <div><div class="mb-3 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-[var(--color-primary)]/10 text-[var(--color-primary)]"><partial name="_Icon" model='new IconVm { Name = "sparkles", Size = 20, StrokeWidth = "1.75" }'/></div><h2 id="ai-assistant-title" class="font-display text-xl font-bold text-fg">Create with AI</h2><p class="mt-1 text-sm leading-6 text-fg-secondary">Describe what you need in plain language. You'll review the suggested details before anything is saved.</p></div>
                <button type="button" data-ai-close class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-fg-muted transition-colors hover:bg-raised hover:text-fg" aria-label="Close AI assistant"><partial name="_Icon" model='new IconVm { Name = "x-mark", Size = 20 }'/></button>
            </div>
            @Html.AntiForgeryToken()
            @if (!canCreateTask && !canCreateProject)
            {
                <p class="mt-6 rounded-lg bg-[var(--color-surface-container)] px-3 py-2 text-sm text-fg-secondary">Create a workspace first, then you can create projects and tasks with AI.</p>
            }
            else
            {
                <form data-ai-form class="mt-6">
                    <label for="ai-mode" class="text-sm font-semibold text-fg">Create</label>
                    <select id="ai-mode" data-ai-mode class="mt-2 block w-full rounded-xl border border-border bg-app px-3 py-2.5 text-sm text-fg outline-none">
                        @if (canCreateTask) { <option value="task" selected="@(initialMode == "task")">Task</option> }
                        @if (canCreateProject) { <option value="project" selected="@(initialMode == "project")">Project</option> }
                    </select>
                    <div data-ai-task-context class="mt-4"><label for="ai-task-project" class="text-sm font-semibold text-fg">Project</label><select id="ai-task-project" data-ai-project class="mt-2 block w-full rounded-xl border border-border bg-app px-3 py-2.5 text-sm text-fg">@foreach (var project in Model.Projects) { <option value="@project.Id" selected="@(project.Id == Model.ActiveProjectId)">@project.Name</option> }</select></div>
                    <div data-ai-project-context class="mt-4 hidden"><label for="ai-project-workspace" class="text-sm font-semibold text-fg">Workspace</label><select id="ai-project-workspace" data-ai-workspace class="mt-2 block w-full rounded-xl border border-border bg-app px-3 py-2.5 text-sm text-fg">@foreach (var workspace in Model.Workspaces) { <option value="@workspace.Id" selected="@(workspace.Id == Model.ActiveWorkspaceId)">@workspace.Name</option> }</select></div>
                    <label for="ai-prompt" data-ai-prompt-label class="mt-4 block text-sm font-semibold text-fg">What task should we create?</label>
                    <textarea id="ai-prompt" data-ai-prompt rows="4" required class="mt-2 block w-full resize-none rounded-xl border border-border bg-app px-3 py-3 text-sm text-fg outline-none" placeholder="Create a high-priority presentation task for Friday"></textarea>
                    <p data-ai-example class="mt-2 text-xs text-fg-muted">For example: “Prepare the sprint review slides by Friday, high priority.”</p>
                    <div class="mt-6 flex items-center justify-end gap-3"><button type="button" data-ai-close class="rounded-lg px-3 py-2 text-sm font-semibold text-fg-secondary hover:bg-raised">Cancel</button><button type="submit" data-ai-generate class="inline-flex items-center gap-2 rounded-lg bg-[var(--color-primary)] px-4 py-2 text-sm font-semibold text-[var(--color-on-primary)]"><partial name="_Icon" model='new IconVm { Name = "sparkles", Size = 16, StrokeWidth = "1.75" }'/>Generate task</button></div>
                    <p data-ai-status class="mt-4 hidden rounded-lg bg-[var(--color-surface-container)] px-3 py-2 text-sm text-fg-secondary" role="status"></p>
                </form>
                <section data-ai-preview class="mt-6 hidden rounded-xl border border-border bg-[var(--color-surface-container-low)] p-4">
                    <p class="text-xs font-bold uppercase tracking-wide text-fg-muted">Review suggested <span data-ai-preview-kind>task</span></p>
                    <dl class="mt-3 space-y-2 text-sm"><div><dt data-ai-preview-name-label class="inline font-semibold text-fg">Title: </dt><dd data-ai-preview-name class="inline text-fg-secondary"></dd></div><div data-ai-preview-description-row><dt class="inline font-semibold text-fg">Description: </dt><dd data-ai-preview-description class="inline text-fg-secondary"></dd></div><div data-ai-preview-status-row class="hidden"><dt class="inline font-semibold text-fg">Status: </dt><dd data-ai-preview-status class="inline capitalize text-fg-secondary"></dd></div><div><dt class="inline font-semibold text-fg">Priority: </dt><dd data-ai-preview-priority class="inline capitalize text-fg-secondary"></dd></div><div data-ai-preview-start-date-row class="hidden"><dt class="inline font-semibold text-fg">Start date: </dt><dd data-ai-preview-start-date class="inline text-fg-secondary"></dd></div><div data-ai-preview-due-date-row><dt class="inline font-semibold text-fg">Due date: </dt><dd data-ai-preview-due-date class="inline text-fg-secondary"></dd></div></dl>
                    <div class="mt-5 flex justify-end gap-3"><button type="button" data-ai-back-to-prompt class="rounded-lg px-3 py-2 text-sm font-semibold text-fg-secondary hover:bg-raised">Back</button><button type="button" data-ai-create class="rounded-lg bg-[var(--color-primary)] px-4 py-2 text-sm font-semibold text-[var(--color-on-primary)]">Create task</button></div>
                </section>
            }
        </section>
    </div>
</div>
