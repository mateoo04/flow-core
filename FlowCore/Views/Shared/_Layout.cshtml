@using FlowCore.Repositories
@using FlowCore.Services
@inject IWorkspaceRepository WorkspaceRepo
@inject ICurrentUserAccessor CurrentUser
@inject FlowCore.Services.UiText T
@{
    string? profileName = null;
    string? profileEmailTop = null;
    string initials = "?";
    List<FlowCore.Models.Workspace> workspaces;
    if (User.Identity?.IsAuthenticated == true)
    {
        workspaces = (await WorkspaceRepo.GetForUserAsync(CurrentUser.UserId)).ToList();
        var me = await CurrentUser.GetAsync();
        profileName = me?.FullName ?? User.Identity.Name ?? "";
        profileEmailTop = me?.Email ?? "";
        var parts = profileName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        initials = parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpper(),
            _ => $"{parts[0][..1]}{parts[1][..1]}".ToUpper()
        };
    }
    else
    {
        workspaces = new List<FlowCore.Models.Workspace>();
    }
    var allProjects = workspaces.SelectMany(w => w.Projects).ToList();
    var activeWs = ViewData["ActiveWorkspaceId"] as Guid?;
    var activeProject = ViewData["ActiveProjectId"] as Guid?;
    var sidebarProjects = activeWs is { } w
        ? allProjects.Where(p => p.WorkspaceId == w).OrderBy(p => p.Name).Take(12).ToList()
        : allProjects.OrderBy(p => p.Name).Take(8).ToList();

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var defaultSearchTab = (currentController, currentAction) switch
    {
        ("Projects", "Index") => SearchTab.Projects,
        ("Projects", _) => SearchTab.Tasks,
        ("Boards", _) => SearchTab.Tasks,
        ("Tasks", _) => SearchTab.Tasks,
        ("Users", _) => SearchTab.Users,
        _ => SearchTab.Projects
    };
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName" class="h-full">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet"/>
    <script>
        (function () {
            try {
                var k = 'flowcore-theme';
                var s = localStorage.getItem(k);
                var dark = s === 'dark' || (s !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
                document.documentElement.classList.toggle('dark', dark);
            } catch (e) {}
        })();
    </script>
    <title>@ViewData["Title"] - FlowCore</title>
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/FlowCore.styles.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/lib/flatpickr/flatpickr.min.css" asp-append-version="true"/>
</head>
<body class="antialiased">
<a class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-card focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-fg focus:shadow-card focus:outline focus:outline-2 focus:outline-offset-2 focus:outline-brand"
   href="#main-content">Skip to main content</a>
<div class="flex h-screen max-h-screen min-h-0 flex-col overflow-hidden lg:flex-row">
    @{
        var onHome = ViewContext.RouteData.Values["controller"]?.ToString() == "Home";
        var onProjectsIndex = ViewContext.RouteData.Values["controller"]?.ToString() == "Projects" && ViewContext.RouteData.Values["action"]?.ToString() == "Index";
        var onSettings = ViewContext.RouteData.Values["controller"]?.ToString() == "Settings";
    }
    <header class="flex h-16 shrink-0 items-center gap-2 border-b border-border bg-sidebar px-4 lg:hidden">

        <button type="button" data-mobile-sidebar-toggle aria-controls="site-sidebar" aria-expanded="false" aria-label="Open navigation"
                class="inline-flex h-10 w-10 items-center justify-center rounded-md text-fg-secondary transition-colors hover:bg-[var(--color-surface-container)] hover:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
            <partial name="_Icon" model='new IconVm { Name = "bars-3", Size = 24 }'/>
        </button>
                <a class="group flex min-w-0 items-center no-underline outline-none transition-opacity hover:opacity-90 focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 focus-visible:ring-offset-sidebar"
           asp-controller="Home" asp-action="Index">
            <span class="flex items-center gap-2">
                <partial name="_Icon" model='new IconVm { Name = "square-3-stack-3d", Size = 24, CssClass = "text-[var(--color-primary)]" }'/>
                <span class="font-display text-xl font-black tracking-tight text-fg">FlowCore</span>
            </span>
        </a>
    </header>

    <button type="button" class="fixed inset-0 z-[100] hidden bg-black/30 lg:hidden" aria-label="Close navigation" data-mobile-sidebar-backdrop></button>
    <aside id="site-sidebar" class="fixed inset-y-0 left-0 z-[110] hidden h-[100dvh] min-h-0 w-64 shrink-0 flex-col overflow-hidden border-r border-border bg-sidebar shadow-xl lg:static lg:z-auto lg:flex lg:h-full lg:shadow-none" aria-label="Site navigation" aria-hidden="true" data-sidebar>
        <div class="flex shrink-0 items-center justify-between px-4 pt-6 pb-4">
            <a class="group flex min-w-0 items-center no-underline outline-none transition-opacity hover:opacity-90 focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 focus-visible:ring-offset-sidebar"
               asp-controller="Home" asp-action="Index">
                <div class="flex items-center gap-2">
                    <partial name="_Icon" model='new IconVm { Name = "square-3-stack-3d", Size = 28, CssClass = "text-[var(--color-primary)]" }'/>
                    <span class="font-display text-2xl font-black tracking-tight text-fg">FlowCore</span>
                </div>
            </a>
            <button type="button" data-mobile-sidebar-close aria-label="Close navigation"
                    class="inline-flex h-10 w-10 items-center justify-center rounded-md text-fg-secondary transition-colors hover:bg-[var(--color-surface-container)] hover:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand lg:hidden">
                <partial name="_Icon" model='new IconVm { Name = "x-mark", Size = 22 }'/>
            </button>
        </div>

        @* Main view *@
        <div data-sidebar-view="main" class="flex min-h-0 flex-1 flex-col overflow-hidden">
            <div class="shrink-0 px-4 pb-4">
                <partial name="_SearchPanel" model="@(new SearchPanelRootVm(defaultSearchTab))"/>
            </div>
            <div class="shrink-0 px-7 pb-2 text-[10px] font-bold uppercase tracking-[0.14em] text-fg-muted">@T["nav.views"]</div>
            <nav class="min-h-0 flex-1 space-y-1 overflow-y-auto px-3 pb-2 text-sm" aria-label="Main">
                <a class="group flex items-center gap-3 rounded-md px-3 py-3 text-[13px] font-medium transition-[background-color,color] duration-200 ease-out @(onHome ? "bg-[var(--color-primary)] font-semibold text-[var(--color-on-primary)] fc-nav-active" : "text-fg-secondary hover:bg-[var(--color-surface-container)] hover:text-fg")"
                   asp-controller="Home" asp-action="Index">
                    <partial name="_Icon" model='new IconVm { Name = "clipboard-document-check", Size = 16, CssClass = "shrink-0" }'/>
                    <span>@T["nav.my_tasks"]</span>
                </a>
                <button type="button" data-sidebar-open="workspaces"
                        class="fc-nav-hover group flex w-full items-center justify-between rounded-md px-3 py-3 text-[13px] font-medium text-fg-secondary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
                    <span class="flex items-center gap-3">
                        <partial name="_Icon" model='new IconVm { Name = "squares-2x2", Size = 16, CssClass = "shrink-0 text-fg-muted transition-colors duration-200 ease-out group-hover:text-fg-secondary" }'/>
                        <span>@T["nav.workspaces"]</span>
                    </span>
                    <partial name="_Icon" model='new IconVm { Name = "chevron-right", Size = 14, CssClass = "text-fg-muted/70 transition-colors duration-200 ease-out group-hover:text-fg-secondary" }'/>
                </button>
                <button type="button" data-sidebar-open="projects"
                        class="fc-nav-hover group flex w-full items-center justify-between rounded-md px-3 py-3 text-[13px] font-medium text-fg-secondary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
                    <span class="flex items-center gap-3">
                        <partial name="_Icon" model='new IconVm { Name = "folder", Size = 16, CssClass = "shrink-0 text-fg-muted transition-colors duration-200 ease-out group-hover:text-fg-secondary" }'/>
                        <span>@T["nav.projects"]</span>
                    </span>
                    <partial name="_Icon" model='new IconVm { Name = "chevron-right", Size = 14, CssClass = "text-fg-muted/70 transition-colors duration-200 ease-out group-hover:text-fg-secondary" }'/>
                </button>
            </nav>

            <div class="shrink-0 border-t border-border/70 p-3">
                <a class="flex items-center gap-3 rounded-md px-3 py-2 text-[13px] font-medium transition-[background-color,color] duration-200 ease-out @(onSettings ? "bg-[var(--color-primary)] text-[var(--color-on-primary)] fc-nav-active" : "text-fg-secondary hover:bg-[var(--color-surface-container)] hover:text-fg")"
                   asp-controller="Settings" asp-action="Index">
                    <partial name="_Icon" model='new IconVm { Name = "cog-6-tooth", Size = 16, CssClass = onSettings ? "shrink-0 text-[var(--color-on-primary)]" : "shrink-0 text-fg-muted" }'/>
                    @T["nav.settings"]
                </a>
                @if (User.IsInRole(FlowCore.Models.AppRoles.Admin))
                {
                    <a class="mt-1 flex items-center gap-3 rounded-md px-3 py-2 text-[13px] font-medium text-fg-secondary transition-[background-color,color] duration-200 ease-out hover:bg-[var(--color-surface-container)] hover:text-fg"
                       asp-controller="Admin" asp-action="Index">
                        Admin
                    </a>
                }
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="mt-1 flex w-full items-center gap-3 rounded-md border border-transparent p-2 transition-[background-color,border-color] duration-200 ease-out hover:border-border/60 hover:bg-[var(--color-surface-container-low)]">
                        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-border/70 bg-[var(--color-primary)]/10 text-[11px] font-semibold text-fg" aria-hidden="true">@initials</span>
                        <span class="min-w-0 flex-1">
                            <span class="block truncate text-[13px] font-semibold leading-tight text-fg">@profileName</span>
                            @if (profileEmailTop is { Length: > 0 })
                            {
                                <span class="block truncate text-[11px] leading-tight text-fg-muted">@profileEmailTop</span>
                            }
                        </span>
                        <form method="post" asp-controller="Account" asp-action="Logout" class="shrink-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" aria-label="Sign out" class="inline-flex items-center text-fg-muted transition-colors hover:text-fg">
                                <partial name="_Icon" model='new IconVm { Name = "arrow-right-on-rectangle", Size = 13 }'/>
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="mt-1 flex w-full items-center gap-3 rounded-md border border-transparent px-3 py-2 text-[13px] font-medium text-fg-secondary">
                        <a asp-controller="Account" asp-action="Login" class="underline hover:text-fg transition-colors">Sign in</a>
                        <a asp-controller="Account" asp-action="Register" class="underline hover:text-fg transition-colors">Sign up</a>
                    </div>
                }
            </div>
        </div>

        @* Workspaces sub-panel *@
        <div data-sidebar-view="workspaces" class="hidden min-h-0 flex-1 flex-col overflow-hidden">
            <div class="shrink-0 px-3 pb-1">
                <button type="button" data-sidebar-close
                        class="fc-nav-hover group flex w-full items-center gap-2 rounded-md px-3 py-2 text-[13px] font-medium text-fg-secondary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
                    <partial name="_Icon" model='new IconVm { Name = "chevron-left", Size = 16 }'/>
                    Back
                </button>
            </div>
            <div class="shrink-0 px-7 pb-2 text-[10px] font-bold uppercase tracking-[0.16em] text-fg-muted">@T["nav.workspaces"]</div>
            <div class="min-h-0 flex-1 space-y-0.5 overflow-y-auto px-3 pb-3 text-sm">
                @foreach (var ws in workspaces)
                {
                    var wsActive = activeWs == ws.Id;
                    <a class="block truncate rounded-md px-3 py-2 text-sm text-fg-secondary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand @(wsActive ? "bg-raised font-semibold text-fg" : "fc-nav-hover")"
                       asp-controller="Workspaces" asp-action="Details" asp-route-id="@ws.Id"
                       title="@ws.Name">@ws.Name</a>
                }
            </div>
        </div>

        @* Projects sub-panel *@
        <div data-sidebar-view="projects" class="hidden min-h-0 flex-1 flex-col overflow-hidden">
            <div class="shrink-0 px-3 pb-1">
                <button type="button" data-sidebar-close
                        class="fc-nav-hover group flex w-full items-center gap-2 rounded-md px-3 py-2 text-[13px] font-medium text-fg-secondary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
                    <partial name="_Icon" model='new IconVm { Name = "chevron-left", Size = 16 }'/>
                    Back
                </button>
            </div>
            <div class="shrink-0 px-7 pb-2 text-[10px] font-bold uppercase tracking-[0.16em] text-fg-muted">@T["nav.projects"]</div>
            <div class="min-h-0 flex-1 space-y-0.5 overflow-y-auto px-3 pb-3 text-sm">
                <a class="fc-nav-hover flex items-center gap-2 rounded-md px-3 py-2 text-sm font-semibold text-[var(--color-secondary)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-secondary)]"
                   asp-controller="Projects" asp-action="Create">
                    <partial name="_Icon" model='new IconVm { Name = "plus", Size = 16 }'/>
                    New project
                </a>
                <a class="block rounded-md px-3 py-2 text-sm text-fg-secondary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand @(onProjectsIndex ? "bg-raised font-semibold text-fg" : "fc-nav-hover")"
                   asp-controller="Projects" asp-action="Index">@T["nav.all_projects"]</a>
                @foreach (var p in sidebarProjects)
                {
                    var pActive = activeProject == p.Id;
                    <a class="block min-w-0 truncate rounded-md px-3 py-2 text-sm text-fg-secondary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand @(pActive ? "bg-raised font-semibold text-fg" : "fc-nav-hover")"
                       asp-controller="Projects" asp-action="Details" asp-route-id="@p.Id"
                       title="@p.Name">@p.Name</a>
                }
            </div>
        </div>
    </aside>

    <div class="flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden bg-background">
        <main id="main-content" tabindex="-1" class="min-h-0 flex-1 overflow-y-auto px-4 py-6 sm:px-8 sm:py-8 lg:px-12 lg:py-10">
            <div class="mx-auto max-w-7xl">
                <partial name="_Breadcrumbs"/>
                @RenderBody()
            </div>
        </main>
    </div>
</div>
@if (IsSectionDefined("Fab"))
{
    @RenderSection("Fab", required: false)
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<partial name="_ValidationScriptsPartial" />
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/lib/flatpickr/flatpickr.min.js" asp-append-version="true"></script>
@if (System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "hr")
{
    <script src="~/lib/flatpickr/l10n/hr.js" asp-append-version="true"></script>
}
<script src="~/js/util.js" asp-append-version="true"></script>
<script src="~/js/datepicker.js" asp-append-version="true"></script>
<script src="~/js/autocomplete.js" asp-append-version="true"></script>
<script src="~/js/search.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
