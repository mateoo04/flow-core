@model DateTimePickerModel
@{
    var iso = Model.IncludeTime
        ? Model.Value?.ToString("yyyy-MM-dd HH:mm")
        : Model.Value?.ToString("yyyy-MM-dd");
}
<input type="text"
       name="@Model.FieldName"
       value="@iso"
       data-datetime-picker
       data-include-time="@(Model.IncludeTime ? "true" : "false")"
       autocomplete="off"
       placeholder="@(Model.Placeholder ?? "")"
       @(Model.Required ? "required" : "")
       class="w-full rounded-xl border border-border bg-[var(--color-surface)] px-3 py-2 text-fg focus:border-[var(--color-secondary)] focus:outline-none focus:ring-1 focus:ring-[var(--color-secondary)]"/>
