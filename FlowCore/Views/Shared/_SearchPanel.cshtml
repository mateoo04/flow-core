@model SearchPanelRootVm
@inject FlowCore.Services.UiText T
@{
    var defaultTab = Model.DefaultTab.ToString().ToLowerInvariant();
}
<div data-search-root data-default-tab="@defaultTab" data-search-url="@Url.Action("Results", "Search")">
    <button type="button" data-search-trigger
            class="group flex w-full items-center gap-2 rounded-lg border border-border bg-app px-3 py-2 text-sm text-fg-muted outline-none transition-colors hover:bg-raised focus-visible:ring-2 focus-visible:ring-brand dark:bg-raised/50"
            aria-haspopup="dialog">
        <svg class="h-4 w-4 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" /></svg>
        <span class="flex-1 text-left">@T["nav.search_placeholder"]</span>
    </button>

    <div class="fixed inset-0 z-50 hidden items-start justify-center p-4 pt-[10vh] sm:p-8 sm:pt-[12vh]"
         data-search-modal role="dialog" aria-modal="true" aria-label="@T["nav.search_placeholder"]">
        <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" data-search-backdrop aria-hidden="true"></div>

        <div class="relative w-full max-w-2xl overflow-hidden rounded-2xl border border-border bg-[var(--color-surface)] shadow-2xl">
            <div class="relative border-b border-border/60">
                <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-fg-muted" aria-hidden="true">
                    <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" /></svg>
                </span>
                <input type="search" autocomplete="off" data-search-input
                       class="w-full border-0 bg-transparent py-4 pl-12 pr-12 text-base text-fg placeholder:text-fg-muted outline-none focus:ring-0"
                       placeholder="@T["nav.search_placeholder"]"
                       role="combobox"
                       aria-expanded="true"
                       aria-controls="search-modal-results"/>
                <button type="button" data-search-close
                        class="absolute right-3 top-1/2 -translate-y-1/2 cursor-pointer rounded-md px-1.5 py-0.5 text-[10px] font-semibold text-fg-muted ring-1 ring-border transition-colors hover:bg-raised hover:text-fg"
                        aria-label="Close search">ESC</button>
            </div>

            <div class="flex gap-1 border-b border-border/60 p-2" role="tablist">
                <button type="button" data-search-tab="projects" role="tab"
                        class="flex-1 cursor-pointer rounded-lg px-3 py-1.5 text-sm font-semibold transition-colors data-[active=true]:bg-[var(--color-primary)] data-[active=true]:text-[var(--color-on-primary)] text-fg-muted hover:bg-raised hover:text-fg">
                    @T["search.tab.projects"]
                </button>
                <button type="button" data-search-tab="tasks" role="tab"
                        class="flex-1 cursor-pointer rounded-lg px-3 py-1.5 text-sm font-semibold transition-colors data-[active=true]:bg-[var(--color-primary)] data-[active=true]:text-[var(--color-on-primary)] text-fg-muted hover:bg-raised hover:text-fg">
                    @T["search.tab.tasks"]
                </button>
                <button type="button" data-search-tab="users" role="tab"
                        class="flex-1 cursor-pointer rounded-lg px-3 py-1.5 text-sm font-semibold transition-colors data-[active=true]:bg-[var(--color-primary)] data-[active=true]:text-[var(--color-on-primary)] text-fg-muted hover:bg-raised hover:text-fg">
                    @T["search.tab.users"]
                </button>
            </div>

            <div id="search-modal-results"
                 class="max-h-[60vh] min-h-[8rem] overflow-auto data-[loading=true]:opacity-60 transition-opacity"
                 role="listbox" data-search-results>
            </div>
        </div>
    </div>
</div>
