@model TagFormVm
<div asp-validation-summary="ModelOnly" class="text-sm text-[var(--color-error)]"></div>
<div>
    <label asp-for="Name" class="block text-sm font-medium text-fg-secondary">Name</label>
    <input asp-for="Name" class="mt-1 w-full rounded-xl border border-border bg-[var(--color-surface)] px-3 py-2 text-fg focus:border-[var(--color-secondary)] focus:outline-none focus:ring-1 focus:ring-[var(--color-secondary)]" required maxlength="50" autocomplete="off"/>
    <span asp-validation-for="Name" class="mt-1 block text-xs text-[var(--color-error)]"></span>
</div>
<div>
    <label asp-for="ColorHex" class="block text-sm font-medium text-fg-secondary">Color</label>
    <div class="mt-1 flex items-center gap-3">
        <input asp-for="ColorHex" type="color" class="h-10 w-10 cursor-pointer rounded-full border border-border" data-tag-color/>
        <span class="font-mono text-sm text-fg-muted" data-tag-color-display>@Model.ColorHex</span>
    </div>
    <span asp-validation-for="ColorHex" class="mt-1 block text-xs text-[var(--color-error)]"></span>
</div>
