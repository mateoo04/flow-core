@model BoardFormVm
@{
    ViewData["Title"] = "New board";
    var project = ViewBag.Project as Project;
}
<h1 class="font-headline text-3xl font-extrabold tracking-tight text-fg">New board</h1>
@if (project is not null)
{
    <p class="mt-2 text-sm font-medium text-fg-secondary">@project.Name</p>
}
<form method="post" asp-action="Create" asp-route-projectId="@Model.ProjectId" class="mt-8 max-w-xl space-y-5">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ProjectId"/>
    <partial name="_BoardForm" model="Model"/>
    <div class="flex gap-3">
        <button type="submit" class="flex items-center gap-2 rounded-full bg-[var(--color-secondary)] px-4 py-2 text-sm font-semibold text-[var(--color-on-secondary)] shadow-sm transition-opacity hover:opacity-95">
            <span class="material-symbols-outlined text-[18px]" aria-hidden="true">add</span>
            Create board
        </button>
        @if (project is not null)
        {
            <a asp-controller="Projects" asp-action="Details" asp-route-id="@project.Id" class="rounded-full border border-border bg-[var(--color-surface)] px-4 py-2 text-sm font-semibold text-fg transition-colors hover:bg-[var(--color-surface-container)]">Cancel</a>
        }
    </div>
</form>
