@model ProjectDetailsPageViewModel
@inject FlowCore.Services.UiText T
@{
    ViewData["Title"] = Model.Project.Name;
    var project = Model.Project;
    var activeBoard = Model.ActiveBoard;
}
<header class="border-b border-fg-muted/15 pb-7">
    <div class="mb-4 text-sm">
        <a class="inline-flex items-center gap-1 rounded text-fg-muted outline-none transition-colors hover:text-fg focus-visible:ring-2 focus-visible:ring-primary" asp-controller="Workspaces" asp-action="Details" asp-route-id="@project.WorkspaceId">
            <partial name="_Icon" model='new IconVm { Name = "arrow-left", Size = 16 }'/>
            Workspace
        </a>
    </div>
    <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="min-w-0">
            <h1 class="mb-2 font-display text-5xl font-extrabold leading-[0.96] tracking-tight text-fg sm:text-6xl">@project.Name</h1>
            <p class="max-w-3xl text-[15px] leading-7 text-fg-secondary">@project.Description</p>
            <div class="mt-5 flex flex-wrap gap-2">
                <span class="rounded-full bg-primary/10 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-primary">@project.Status</span>
                <span class="rounded-full bg-raised px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-fg-secondary">Priority @project.Priority</span>
            </div>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            @if (activeBoard is not null)
            {
                <a class="flex items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-on-primary shadow-sm transition-opacity hover:opacity-95"
                   asp-controller="Tasks" asp-action="Create" asp-route-projectId="@project.Id" asp-route-boardId="@activeBoard.Id">
                    <partial name="_Icon" model='new IconVm { Name = "plus", Size = 18 }'/>
                    New task
                </a>
            }
            <a asp-action="Edit" asp-route-id="@project.Id" class="flex items-center gap-2 rounded-full border border-fg-muted/25 bg-raised/40 px-4 py-2.5 text-sm font-semibold text-fg transition-colors hover:border-primary/35 hover:bg-primary/10">
                <partial name="_Icon" model='new IconVm { Name = "pencil-square", Size = 18 }'/>
                Edit
            </a>
            <form method="post" asp-action="Delete" asp-route-id="@project.Id" class="inline" onsubmit="return confirm('Delete this project and all tasks?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="flex items-center gap-2 rounded-full border border-[var(--color-error)]/50 px-4 py-2.5 text-sm font-semibold text-[var(--color-error)] transition-colors hover:bg-[var(--color-error)]/10">
                    <partial name="_Icon" model='new IconVm { Name = "trash", Size = 18 }'/>
                    @T["crud.projects.delete"]
                </button>
            </form>
        </div>
    </div>
</header>

@if (Model.BoardsOrdered.Count == 0)
{
    <p class="mt-8 rounded-2xl border border-dashed border-fg-muted/25 bg-card p-10 text-center text-fg-muted shadow-soft">No board on this project yet.</p>
}
else
{
    <div class="mt-7 flex flex-wrap items-center gap-2 rounded-2xl border border-fg-muted/15 bg-card p-3 shadow-card" role="tablist" aria-label="Boards">
        @foreach (var b in Model.BoardsOrdered)
        {
            var isActive = Model.ActiveBoard?.Id == b.Id;
            <a role="tab"
               aria-selected="@(isActive ? "true" : "false")"
               class="font-headline rounded-full px-4 py-2 text-sm font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary @(isActive ? "bg-primary text-on-primary shadow-sm" : "border border-fg-muted/20 bg-[var(--color-surface)] text-fg hover:border-primary/35 hover:bg-primary/10")"
               asp-controller="Projects" asp-action="Details" asp-route-id="@project.Id" asp-route-boardId="@b.Id">@b.Name</a>
        }
        <a asp-controller="Boards" asp-action="Create" asp-route-projectId="@project.Id"
           class="font-headline inline-flex items-center gap-1 rounded-full border border-dashed border-fg-muted/30 px-4 py-2 text-sm font-semibold text-fg-secondary transition-colors hover:border-primary/40 hover:bg-primary/10 hover:text-fg">
            <partial name="_Icon" model='new IconVm { Name = "plus", Size = 18 }'/>
            New board
        </a>
        @if (Model.ActiveBoard is { } activeForActions)
        {
            <span class="mx-2 hidden h-6 w-px bg-border sm:inline-block" aria-hidden="true"></span>
            <a asp-controller="Boards" asp-action="Edit" asp-route-id="@activeForActions.Id"
               class="inline-flex items-center gap-1 rounded-full border border-fg-muted/25 bg-raised/40 px-3 py-1.5 text-xs font-semibold text-fg-secondary transition-colors hover:border-primary/35 hover:bg-primary/10">
                <partial name="_Icon" model='new IconVm { Name = "pencil-square", Size = 16 }'/>
                Edit board
            </a>
            <form method="post" asp-controller="Boards" asp-action="Delete" asp-route-id="@activeForActions.Id" class="inline" onsubmit="return confirm('Delete this board and its tasks?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="inline-flex items-center gap-1 rounded-full border border-[var(--color-error)]/40 px-3 py-1.5 text-xs font-semibold text-[var(--color-error)] transition-colors hover:bg-[var(--color-error)]/10">
                    <partial name="_Icon" model='new IconVm { Name = "trash", Size = 16 }'/>
                    Delete board
                </button>
            </form>
        }
    </div>

    @if (Model.ActiveBoard is { } board)
    {
        <partial name="_BoardKanban" model="board"/>
    }
}

@section Fab {
    @if (activeBoard is not null)
    {
        <a class="fixed bottom-8 right-8 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-primary text-on-primary shadow-2xl shadow-primary/30 transition-transform hover:scale-110 active:scale-95"
           asp-controller="Tasks" asp-action="Create" asp-route-projectId="@project.Id" asp-route-boardId="@activeBoard.Id" title="New task">
            <partial name="_Icon" model='new IconVm { Name = "plus", Size = 24 }'/>
            <span class="sr-only">New task</span>
        </a>
    }
}

@section Scripts {
    <script src="~/lib/sortablejs/Sortable.min.js" asp-append-version="true"></script>
    <script src="~/js/board-dnd.js" asp-append-version="true"></script>
}
