@model FlowCore.Models.ViewModels.WorkspaceStatusSettingsVm
@{
    ViewData["Title"] = "Status settings";
    var error = TempData["StatusSettingsError"] as string;
    var ws = Model.ActiveWorkspace;
    var statuses = Model.Statuses;
}
<header class="mb-8 flex flex-wrap items-end justify-between gap-6 border-b border-fg-muted/15 pb-6">
    <div class="min-w-0">
        <div class="mb-4 text-sm">
            <a class="inline-flex items-center gap-1 rounded text-fg-muted outline-none transition-colors hover:text-fg focus-visible:ring-2 focus-visible:ring-primary"
               asp-controller="Workspaces" asp-action="Details" asp-route-id="@ws.Id">
                <partial name="_Icon" model='new IconVm { Name = "arrow-left", Size = 16 }'/>
                Workspace
            </a>
        </div>
        <h1 class="font-display text-5xl font-extrabold leading-[0.96] tracking-tight text-fg">Status settings</h1>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-fg-secondary">
            Manage task statuses for <span class="font-semibold text-fg">@ws.Name</span>. These statuses appear on task boards inside this workspace.
        </p>
    </div>
    @if (Model.AllWorkspaces.Count > 1)
    {
        <form method="get" asp-action="Manage" class="flex items-center gap-2">
            <label for="workspace-picker" class="text-xs font-semibold uppercase tracking-[0.12em] text-fg-muted">Workspace</label>
            <select id="workspace-picker" name="workspaceId" onchange="window.location.href='/workspaces/' + this.value + '/statuses'"
                    class="rounded-full border border-fg-muted/25 bg-[var(--color-surface)] px-4 py-2 text-sm font-semibold text-fg focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary">
                @foreach (var w in Model.AllWorkspaces)
                {
                    <option value="@w.Id" selected="@(w.Id == ws.Id)">@w.Name</option>
                }
            </select>
        </form>
    }
</header>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="mb-6 rounded-2xl border border-[var(--color-error)]/40 bg-[var(--color-error)]/10 px-5 py-3 text-sm text-fg">
        @error
    </div>
}

<section aria-labelledby="statuses-heading" class="space-y-4">
    <div class="flex items-center gap-3">
        <h2 id="statuses-heading" class="text-xs font-bold uppercase tracking-[0.14em] text-fg-muted">Statuses</h2>
        <span class="rounded-full bg-primary/10 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-primary">@statuses.Count</span>
    </div>

    @if (statuses.Count == 0)
    {
        <p class="rounded-2xl border border-dashed border-fg-muted/25 bg-card p-10 text-center text-fg-muted shadow-soft">No statuses yet. Add one below.</p>
    }
    else
    {
        <ul class="space-y-3">
            @for (var i = 0; i < statuses.Count; i++)
            {
                var s = statuses[i];
                <li class="rounded-2xl border border-fg-muted/15 bg-card p-4 shadow-card">
                    <form method="post" asp-action="Update" asp-route-workspaceId="@ws.Id" asp-route-id="@s.Id" class="flex flex-wrap items-center gap-3">
                        @Html.AntiForgeryToken()
                        <input type="text" name="Name" value="@s.Name" required
                               class="min-w-0 flex-1 rounded-xl border border-fg-muted/20 bg-[var(--color-surface)] px-4 py-2.5 text-sm text-fg outline-none focus:border-primary focus:ring-1 focus:ring-primary"
                               aria-label="Status name"/>
                        <input type="color" name="ColorHex" value="@s.ColorHex"
                               class="h-8 w-8 cursor-pointer rounded-full border border-border"
                               aria-label="Status color"/>
                        <label class="inline-flex items-center gap-2 text-xs text-fg-secondary">
                            <input type="checkbox" name="IsDoneState" value="true" @(s.IsDoneState ? "checked" : "") class="h-4 w-4 cursor-pointer rounded border border-border accent-[var(--color-primary)]"/>
                            Done state
                        </label>
                        <span class="text-[10px] font-semibold uppercase tracking-wider text-fg-muted">@s.TaskItems.Count tasks</span>
                        <button type="submit" class="rounded-full border border-fg-muted/25 bg-raised/40 px-4 py-2 text-xs font-semibold text-fg transition-colors hover:border-primary/35 hover:bg-primary/10">Save</button>
                    </form>

                    <div class="mt-3 flex flex-wrap items-center gap-2">
                        <form method="post" asp-action="Reorder" asp-route-workspaceId="@ws.Id" asp-route-id="@s.Id" class="inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="direction" value="-1"/>
                            <button type="submit" @(i == 0 ? "disabled" : "")
                                    class="rounded-full border border-fg-muted/25 bg-[var(--color-surface)] px-3 py-1.5 text-xs font-semibold text-fg-secondary transition-colors hover:border-primary/35 hover:bg-primary/10 disabled:cursor-not-allowed disabled:opacity-40">
                                Move up
                            </button>
                        </form>
                        <form method="post" asp-action="Reorder" asp-route-workspaceId="@ws.Id" asp-route-id="@s.Id" class="inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="direction" value="1"/>
                            <button type="submit" @(i == statuses.Count - 1 ? "disabled" : "")
                                    class="rounded-full border border-fg-muted/25 bg-[var(--color-surface)] px-3 py-1.5 text-xs font-semibold text-fg-secondary transition-colors hover:border-primary/35 hover:bg-primary/10 disabled:cursor-not-allowed disabled:opacity-40">
                                Move down
                            </button>
                        </form>
                        <form method="post" asp-action="Delete" asp-route-workspaceId="@ws.Id" asp-route-id="@s.Id" class="inline" onsubmit="return confirm('Delete this status?');">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="rounded-full border border-[var(--color-error)]/50 px-3 py-1.5 text-xs font-semibold text-[var(--color-error)] transition-colors hover:bg-[var(--color-error)]/10">
                                Delete
                            </button>
                        </form>
                    </div>
                </li>
            }
        </ul>
    }
</section>

<section aria-labelledby="add-status-heading" class="mt-10">
    <h2 id="add-status-heading" class="text-xs font-bold uppercase tracking-[0.14em] text-fg-muted">Add status</h2>
    <form method="post" asp-action="Create" asp-route-workspaceId="@ws.Id" class="mt-4 max-w-xl space-y-4 rounded-2xl border border-fg-muted/15 bg-card p-6 shadow-card">
        @Html.AntiForgeryToken()
        <div>
            <label for="new-status-name" class="block text-xs font-semibold uppercase tracking-[0.12em] text-fg-muted">Name</label>
            <input id="new-status-name" type="text" name="Name" required
                   class="mt-1.5 w-full rounded-xl border border-fg-muted/20 bg-[var(--color-surface)] px-4 py-3 text-sm text-fg shadow-soft outline-none focus:border-primary focus:ring-1 focus:ring-primary"/>
        </div>
        <div>
            <label for="new-status-color" class="block text-xs font-semibold uppercase tracking-[0.12em] text-fg-muted">Color</label>
            <input id="new-status-color" type="color" name="ColorHex" value="#94a3b8"
                   class="mt-1 h-10 w-10 cursor-pointer rounded-full border border-border"/>
        </div>
        <label class="inline-flex items-center gap-2 text-sm text-fg-secondary">
            <input type="checkbox" name="IsDoneState" value="true" class="h-4 w-4 cursor-pointer rounded border border-border accent-[var(--color-primary)]"/>
            Mark as done state
        </label>
        <div>
            <button type="submit" class="flex items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-on-primary shadow-sm transition-opacity hover:opacity-95">
                <partial name="_Icon" model='new IconVm { Name = "plus", Size = 18 }'/>
                Add status
            </button>
        </div>
    </form>
</section>
