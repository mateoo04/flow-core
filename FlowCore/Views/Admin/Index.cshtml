@model FlowCore.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin";
}
<h1 class="font-headline text-3xl font-extrabold tracking-tight text-fg">Admin dashboard</h1>

<section class="mt-8">
    <h2 class="font-headline text-xl font-bold text-fg">Users (@Model.Users.Count)</h2>
    <table class="mt-3 w-full text-sm">
        <thead class="text-left text-fg-secondary">
            <tr><th class="py-2">Email</th><th>Name</th><th>Roles</th><th>Active</th></tr>
        </thead>
        <tbody>
        @foreach (var u in Model.Users)
        {
            <tr class="border-t border-border">
                <td class="py-2 text-fg">@u.Email</td>
                <td class="text-fg-secondary">@u.FullName</td>
                <td class="text-fg-secondary">@string.Join(", ", u.Roles)</td>
                <td class="text-fg-secondary">@(u.IsActive ? "Yes" : "No")</td>
            </tr>
        }
        </tbody>
    </table>
</section>

<section class="mt-10">
    <h2 class="font-headline text-xl font-bold text-fg">Workspaces (@Model.Workspaces.Count)</h2>
    <table class="mt-3 w-full text-sm">
        <thead class="text-left text-fg-secondary">
            <tr><th class="py-2">Name</th><th>Visibility</th><th>Members</th><th>Projects</th></tr>
        </thead>
        <tbody>
        @foreach (var w in Model.Workspaces)
        {
            <tr class="border-t border-border">
                <td class="py-2 text-fg">@w.Name</td>
                <td class="text-fg-secondary">@w.Visibility</td>
                <td class="text-fg-secondary">@w.MemberCount</td>
                <td class="text-fg-secondary">@w.ProjectCount</td>
            </tr>
        }
        </tbody>
    </table>
</section>
