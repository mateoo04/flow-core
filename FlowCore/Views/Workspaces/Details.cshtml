@model Workspace
@{
    ViewData["Title"] = Model.Name;
    var error = TempData["WorkspaceError"] as string;
}
@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="mb-6 rounded-2xl border border-[var(--color-error)]/40 bg-[var(--color-error)]/10 px-5 py-3 text-sm text-fg">
        @error
    </div>
}
<div class="flex flex-wrap items-baseline justify-between gap-3">
    <h1 class="text-3xl font-bold tracking-tight text-fg">@Model.Name</h1>
    <div class="flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="rounded-lg border border-border px-3 py-2 text-sm font-medium text-fg hover:bg-[var(--color-surface-container)]">Edit</a>
        <form method="post" asp-action="Delete" asp-route-id="@Model.Id" onsubmit="return confirm('Delete this workspace?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="rounded-lg border border-brand-warn/40 px-3 py-2 text-sm font-medium text-brand-warn hover:bg-brand-warn/10">Delete</button>
        </form>
    </div>
</div>
<p class="mt-2 max-w-3xl text-fg-secondary">@Model.Description</p>

<dl class="mt-6 grid gap-3 text-sm sm:grid-cols-[8rem_1fr]">
    <dt class="text-fg-muted">Visibility</dt>
    <dd class="text-fg">@Model.Visibility</dd>
    <dt class="text-fg-muted">Created</dt>
    <dd class="text-fg-secondary">@Model.CreatedAt.ToString("u")</dd>
</dl>

<section class="mt-10">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="text-lg font-semibold text-fg">Projects</h2>
        <a class="rounded-lg border border-brand/40 px-4 py-2 text-sm font-medium text-brand transition-colors hover:bg-brand/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
           asp-controller="Projects" asp-action="Index" asp-route-workspaceId="@Model.Id">View filtered list</a>
    </div>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
        @foreach (var p in Model.Projects.OrderBy(x => x.Name))
        {
            <a asp-controller="Projects" asp-action="Details" asp-route-id="@p.Id"
               class="rounded-xl border border-fg-muted/10 bg-card p-4 shadow-card outline-none transition-colors duration-150 hover:border-brand/30 hover:bg-raised focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 focus-visible:ring-offset-app">
                <div class="font-medium text-fg">@p.Name</div>
                <div class="mt-2 flex gap-2 text-xs text-fg-muted">
                    <span class="rounded-md bg-raised px-2 py-0.5">@p.Status</span>
                    @if (p.DueDate is { } due)
                    {
                        <span>Due @due.ToString("d")</span>
                    }
                </div>
            </a>
        }
    </div>
</section>

<div class="mt-10">
@{
    var members = (IReadOnlyList<FlowCore.Models.ViewModels.WorkspaceMemberRow>?)ViewBag.Members
        ?? new List<FlowCore.Models.ViewModels.WorkspaceMemberRow>();
    var isOwner = (bool?)ViewBag.IsCurrentUserOwner ?? false;
}
<partial name="_WorkspaceMembers" model="(Model.Id, members, isOwner)" />
</div>
