@model WorkspaceFormVm
@{
    ViewData["Title"] = "Edit workspace";
}
<header class="mb-8 border-b border-fg-muted/15 pb-6">
    <h1 class="font-display text-5xl font-extrabold leading-[0.96] tracking-tight text-fg">Edit workspace</h1>
    <p class="mt-3 max-w-2xl text-sm leading-6 text-fg-secondary">Update the workspace name, description, and visibility. These settings shape how projects are grouped across the app.</p>
</header>

<form method="post" asp-action="Edit" asp-route-id="@Model.Id" class="max-w-2xl rounded-2xl border border-fg-muted/15 bg-card p-6 shadow-card">
    @Html.AntiForgeryToken()
    <div class="space-y-5">
        <partial name="_WorkspaceForm" model="Model"/>
    </div>
    <div class="mt-6 flex flex-wrap gap-3 border-t border-fg-muted/15 pt-5">
        <button type="submit" class="flex items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-on-primary shadow-sm transition-opacity hover:opacity-95">
            <partial name="_Icon" model='new IconVm { Name = "check-circle", Size = 18 }'/>
            Save changes
        </button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="rounded-full border border-fg-muted/25 bg-raised/40 px-5 py-2.5 text-sm font-semibold text-fg transition-colors hover:border-primary/35 hover:bg-primary/10">Cancel</a>
    </div>
</form>
