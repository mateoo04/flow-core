@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authz
@{
    ViewData["Title"] = "Settings";
}
<header class="mb-8 border-b border-fg-muted/15 pb-6">
    <div class="min-w-0">
        <h1 class="font-display text-5xl font-extrabold leading-[0.96] tracking-tight text-fg">Settings</h1>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-fg-secondary">
            Appearance and demo account controls. Workspace workflow statuses live with each workspace.
        </p>
    </div>
</header>

<section aria-labelledby="appearance-heading" class="mb-9 space-y-4">
    <div class="flex items-center gap-3">
        <h2 id="appearance-heading" class="text-xs font-bold uppercase tracking-[0.14em] text-fg-muted">Appearance</h2>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-fg-muted/15 bg-card p-6 shadow-card">
        <div class="min-w-0">
            <p class="text-sm font-semibold text-fg">Color theme</p>
            <p class="mt-1 text-xs text-fg-secondary">Switch between light and dark mode. Your choice is remembered on this device.</p>
        </div>
        <button type="button"
                id="theme-toggle"
                class="inline-flex shrink-0 items-center gap-2 rounded-full border border-fg-muted/25 bg-raised/40 px-4 py-2 text-sm font-semibold text-fg transition-colors hover:border-primary/35 hover:bg-primary/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                aria-label="Switch color theme"
                aria-pressed="false">
            <svg class="h-4 w-4 dark:hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"/>
            </svg>
            <svg class="hidden h-4 w-4 dark:block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/>
            </svg>
            <span class="dark:hidden">Light mode</span>
            <span class="hidden dark:inline">Dark mode</span>
        </button>
    </div>
</section>
@{
    var isDemoUser = (await Authz.AuthorizeAsync(User, null, "DemoUser")).Succeeded;
}
@if (isDemoUser)
{
    <section class="mt-8 rounded-2xl border border-fg-muted/15 bg-card p-6 shadow-card">
        <h2 class="text-xs font-bold uppercase tracking-[0.14em] text-fg-muted">Demo controls</h2>
        <p class="mb-4 mt-2 text-sm text-fg-secondary">
            Reset all demo workspaces, projects, tasks, and comments back to the original seed.
            Real user accounts are not affected.
        </p>
        <form asp-controller="Account" asp-action="ResetDemo" method="post">
            <button type="submit"
                    onclick="return confirm('This wipes all demo workspaces and their data. Continue?');"
                    class="rounded-full bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700">
                Reset demo data
            </button>
        </form>
    </section>
}
